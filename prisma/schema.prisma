generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum BookingStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id               String    @id @default(cuid())
  name             String
  slug             String    @unique
  description      String
  price            Int
  duration         String?
  includedServices String?
  imageUrl         String?
  isActive         Boolean   @default(true)
  displayOrder     Int       @default(0)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portfolio {
  id              String  @id @default(cuid())
  title           String
  slug            String  @unique
  description     String?
  imageUrl        String
  location        String?
  photographyType String?
  isPublished     Boolean @default(true)
  displayOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id          String        @id @default(cuid())
  clientName  String
  phone       String
  email       String?
  bookingDate DateTime
  bookingTime String
  location    String
  notes       String?
  status      BookingStatus @default(NEW)

  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([bookingDate])
  @@index([packageId])
}