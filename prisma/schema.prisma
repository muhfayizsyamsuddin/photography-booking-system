generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum BookingStatus {
  NEW
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ImageOrientation {
  PORTRAIT
  LANDSCAPE
  SQUARE
}

enum ImagePosition {
  TOP
  CENTER
  BOTTOM
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Package {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  description      String
  price            Int
  duration         String?
  includedServices String?
  imageUrl         String?
  isActive         Boolean @default(true)
  displayOrder     Int     @default(0)

  bookings Booking[]
  addons   PackageAddon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Portfolio {
  id            String  @id @default(cuid())
  title         String
  slug          String  @unique
  description   String?
  imageUrl      String
  imagePublicId String?
  location      String?

  categoryId String?
  category   PortfolioCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  imageOrientation ImageOrientation @default(PORTRAIT)
  imagePosition    ImagePosition    @default(CENTER)

  isPublished  Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model PortfolioCategory {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  portfolios Portfolio[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
}

model Booking {
  id          String        @id @default(cuid())
  clientName  String
  phone       String
  email       String?
  bookingDate DateTime
  bookingTime String
  location    String
  notes       String?
  status      BookingStatus @default(NEW)

  depositAmount   Int           @default(0)
  totalPayment    Int           @default(0)
  paymentStatus   PaymentStatus @default(UNPAID)
  paymentProofUrl String?
  paymentProofId  String?

  packageId String
  package   Package @relation(fields: [packageId], references: [id])

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  addons BookingAddon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([paymentStatus])
  @@index([bookingDate])
  @@index([packageId])
  @@index([clientId])
}

model PackageAddon {
  id           String  @id @default(cuid())
  name         String
  description  String?
  price        Int
  isActive     Boolean @default(true)
  displayOrder Int     @default(0)

  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  bookingAddons BookingAddon[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId])
  @@index([isActive])
}

model BookingAddon {
  id String @id @default(cuid())

  addonName String
  price     Int

  addonId String?
  addon   PackageAddon? @relation(fields: [addonId], references: [id], onDelete: SetNull)

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([addonId])
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  startTime String?
  endTime   String?
  reason    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
}

model Client {
  id    String  @id @default(cuid())
  name  String
  phone String
  email String?
  notes String?

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([phone])
  @@index([name])
  @@index([email])
}

model Testimonial {
  id            String  @id @default(cuid())
  clientName    String
  clientContext String?
  quote         String

  isPublished  Boolean @default(true)
  displayOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isPublished])
  @@index([displayOrder])
}
